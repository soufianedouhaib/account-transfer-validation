# Required. The Opus service key. Server side only, never sent to the browser.
OPUS_SERVICE_KEY=_your_service_key_here

# Optional. Defaults are already correct for the Account Transfer Validation workflow.
OPUS_BASE_URL=https://operator.opus.com/api/v1
OPUS_WORKFLOW_ID=471f6915-8b0d-43ed-8d11-fdc226d48abc

# Optional. Pin a workflow version instead of running the latest active one.
# OPUS_WORKFLOW_VERSION=3

# Optional. History storage. Connect a Vercel KV / Upstash Redis store and these
# arrive automatically, usually with a project prefix such as MYSTORE_KV_REST_API_URL.
# The app matches them by suffix, so the prefix does not matter.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# or a TCP connection string:
# REDIS_URL=
